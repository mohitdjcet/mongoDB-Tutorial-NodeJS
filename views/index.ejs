<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Data</title>
</head>
<body>
    <h1> Student Data </h1>
    <table border="1" cellpadding="8">
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th>CITY</th>
        </tr>
        <% students.forEach(student => { %>
            <tr>
                <td><%= student.Name %></td>
                <td><%= student.age %></td>
                <td><%= student.city %></td>
            </tr>
        <% }) %>
    </table>
</body>
</html>